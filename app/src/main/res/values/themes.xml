<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AJClassA" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg_elev</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialCardViewStyle">@style/Widget.AJ.Card</item>
        <item name="materialButtonStyle">@style/Widget.AJ.Button</item>
        <item name="textInputStyle">@style/Widget.AJ.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.AJ.BottomNav</item>
    </style>
    <style name="Theme.AJClassA.Splash" parent="Theme.AJClassA">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
    <style name="Widget.AJ.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>
    <style name="Widget.AJ.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Widget.AJ.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Widget.AJ.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>
    <style name="Widget.AJ.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.AJ.BottomNav</item>
    </style>
    <style name="ThemeOverlay.AJ.BottomNav" parent="">
        <item name="colorSurface">@color/bg_elev</item>
    </style>
    <style name="Text.AJ.H1" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.AJ.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.AJ.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.AJ.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_muted</item>
    </style>
</resources>
