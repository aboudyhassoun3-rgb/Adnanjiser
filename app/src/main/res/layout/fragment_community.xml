<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Class A" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🟢" android:textSize="12sp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
        android:background="@color/bg_elev">
        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="اكتب رسالة…" android:background="@drawable/bg_input"
            android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
        <ImageButton android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_send" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
