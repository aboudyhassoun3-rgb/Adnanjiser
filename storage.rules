rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    match /avatars/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }
    match /chat/{room}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size < 25 * 1024 * 1024;
    }
    match /library/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size < 100 * 1024 * 1024;
    }
    match /homework/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size < 25 * 1024 * 1024;
    }
    match /ai/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
